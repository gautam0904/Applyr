# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Get connection string from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net
DBNAME=Applyr

# ─── AI / LLM Keys ────────────────────────────────────────────────────────────
# Groq: https://console.groq.com
GROQ_API_KEY=gsk_...

# Google Gemini: https://aistudio.google.com/apikey
# Comma-separated list of keys for rotation
GOOGLE_API_KEYS="AIzaSy..., AIzaSy..."

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ─── Google OAuth (for Drive resume storage) ──────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REFRESH_TOKEN=1//...
GOOGLE_DRIVE_FOLDER_ID=1jFt...   # the Drive folder ID to store resumes

# ─── APY Hub (web scraping) ───────────────────────────────────────────────────
# https://apyhub.com
APY_HUB_API_KEY=APY0...

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── Puppeteer ────────────────────────────────────────────────────────────────
# Must be an ABSOLUTE path on the current machine. Change this on every new machine.
# Mac example:   /Users/yourname/code/MEAN/Applyr/Backend/.cache/puppeteer
# Linux example: /home/yourname/Applyr/Backend/.cache/puppeteer
PUPPETEER_CACHE_DIR=/absolute/path/to/Applyr/Backend/.cache/puppeteer

# ─── Optional: Local MongoDB ──────────────────────────────────────────────────
# Set to true only if you have MongoDB installed locally AND want to use it.
# Leave as false (or omit) when using only MongoDB Atlas.
USE_LOCAL_DB=false
